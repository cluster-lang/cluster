fn substitute(t: string, **kwargs: auto) -> string:
    result: string := ""
    cpp_inject "std::string tmpl = t;"
    cpp_inject "std::string r;"
    cpp_inject "for (size_t i = 0; i < tmpl.size(); i++) {"
    cpp_inject "    if (tmpl[i] == '$' && i+1 < tmpl.size()) {"
    cpp_inject "        i++;"
    cpp_inject "        std::string key;"
    cpp_inject "        if (tmpl[i] == '{') {"
    cpp_inject "            i++;"
    cpp_inject "            while (i < tmpl.size() && tmpl[i] != '}') { key += tmpl[i]; i++; }"
    cpp_inject "        } else if (isalnum(tmpl[i]) || tmpl[i] == '_') {"
    cpp_inject "            while (i < tmpl.size() && (isalnum(tmpl[i]) || tmpl[i] == '_')) { key += tmpl[i]; i++; }"
    cpp_inject "            i--;"
    cpp_inject "        } else { r += '$'; i--; continue; }"
    cpp_inject "        r += kwargs[key];"
    cpp_inject "    } else {"
    cpp_inject "        r += tmpl[i];"
    cpp_inject "    }"
    cpp_inject "}"
    cpp_inject "result = r;"
    return result

fn safe_substitute(t: string, **kwargs: auto) -> string:
    result: string := ""
    cpp_inject "std::string tmpl = t;"
    cpp_inject "std::string r;"
    cpp_inject "for (size_t i = 0; i < tmpl.size(); i++) {"
    cpp_inject "    if (tmpl[i] == '$' && i+1 < tmpl.size()) {"
    cpp_inject "        i++;"
    cpp_inject "        std::string key;"
    cpp_inject "        if (tmpl[i] == '{') {"
    cpp_inject "            i++;"
    cpp_inject "            while (i < tmpl.size() && tmpl[i] != '}') { key += tmpl[i]; i++; }"
    cpp_inject "        } else if (isalnum(tmpl[i]) || tmpl[i] == '_') {"
    cpp_inject "            while (i < tmpl.size() && (isalnum(tmpl[i]) || tmpl[i] == '_')) { key += tmpl[i]; i++; }"
    cpp_inject "            i--;"
    cpp_inject "        } else { r += '$'; i--; continue; }"
    cpp_inject "        auto it = kwargs.find(key);"
    cpp_inject "        if (it != kwargs.end()) {"
    cpp_inject "            r += it->second;"
    cpp_inject "        } else {"
    cpp_inject "            r += std::string(\"${\") + key + \"}\";"
    cpp_inject "        }"
    cpp_inject "    } else {"
    cpp_inject "        r += tmpl[i];"
    cpp_inject "    }"
    cpp_inject "}"
    cpp_inject "result = r;"
    return result
