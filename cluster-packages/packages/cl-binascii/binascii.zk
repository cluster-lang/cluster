fn hexlify(data: string) -> string:
    result: string := ""
    cpp_inject "std::string r;"
    cpp_inject "for (unsigned char c : data) {"
    cpp_inject "    char buf[3]; snprintf(buf, sizeof(buf), \"%02x\", c); r += buf;"
    cpp_inject "}"
    cpp_inject "result = r;"
    return result

fn unhexlify(hexstr: string) -> string:
    result: string := ""
    cpp_inject "std::string r;"
    cpp_inject "for (size_t i = 0; i < hexstr.size(); i += 2) {"
    cpp_inject "    char buf[3] = {hexstr[i], hexstr[i+1], 0};"
    cpp_inject "    r += (char)strtol(buf, nullptr, 16);"
    cpp_inject "}"
    cpp_inject "result = r;"
    return result

fn crc32(data: string) -> int:
    result := 0
    cpp_inject "unsigned long crc = 0xFFFFFFFF;"
    cpp_inject "for (unsigned char c : data) {"
    cpp_inject "    crc ^= c;"
    cpp_inject "    for (int j = 0; j < 8; j++)"
    cpp_inject "        crc = (crc >> 1) ^ (0xEDB88320 & ~((crc & 1) - 1));"
    cpp_inject "}"
    cpp_inject "result = (int)(crc ^ 0xFFFFFFFF);"
    return result
