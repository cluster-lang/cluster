import "cl-binascii"

fn token_bytes(nbytes: int = 32) -> string:
    result: string := ""
    cpp_inject "std::string r(nbytes, '\0');"
    cpp_inject "std::random_device rd;"
    cpp_inject "for (int i = 0; i < nbytes; i++) r[i] = (char)rd();"
    cpp_inject "result = r;"
    return result

fn token_hex(nbytes: int = 32) -> string:
    return hexlify(token_bytes(nbytes))

fn token_urlsafe(nbytes: int = 32) -> string:
    result: string := ""
    cpp_inject "std::string r;"
    cpp_inject "std::random_device rd;"
    cpp_inject "const char chars[] = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_\";"
    cpp_inject "for (int i = 0; i < nbytes; i++) r += chars[rd() % 64];"
    cpp_inject "result = r;"
    return result

fn compare_digest(a: string, b: string) -> bool:
    result: bool := false
    cpp_inject "if (a.size() != b.size()) { result = false; }"
    cpp_inject "else {"
    cpp_inject "    unsigned char r = 0;"
    cpp_inject "    for (size_t i = 0; i < a.size(); i++) r |= a[i] ^ b[i];"
    cpp_inject "    result = (r == 0);"
    cpp_inject "}"
    return result
